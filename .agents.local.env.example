# Local-only agent paths. Copy this file to `.agents.local.env` when needed.
# `.agents.local.env` is ignored and must never contain credentials or secrets.
# Paths must be absolute. Leave optional values empty when they are not needed.

# Required only when an agent must create a Git worktree manually.
# The agent asks for this path before creating the first manual worktree.
AGENTS_WORKTREE_CONTAINER_DIR=

# Optional shared location for agent scratch files and temporary reports.
AGENTS_SCRATCH_DIR=

# Optional location for large local artifacts that should not live in the repo.
AGENTS_ARTIFACT_DIR=

# Required for new agent scratch; managed runs keep their recorded directory.
NUCLEUS_SCRATCH_ROOT=

# Optional private publication vocabulary (one literal name per line).
# Relative paths resolve from this checkout; absent default = empty denylist.
# A configured nonempty path must exist. Do not commit the private file.
NUCLEUS_PUBLICATION_DENYLIST=

# Local Effigy compatibility proof inputs (verified against expected hashes).
# Leave empty to skip those proofs; a present path is hashed against the pin.
NUCLEUS_TEST_PINNED_EFFIGY=
NUCLEUS_TEST_QUALIFIED_EFFIGY=

# Optional work placement overrides. Unset defaults to the data home's work/.
# A volume ID pins the exact mounted volume; without a pin no disk check runs.
NUCLEUS_WORK_ROOT=
NUCLEUS_WORK_VOLUME_ID=
