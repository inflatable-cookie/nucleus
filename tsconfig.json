{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "hosts/bb/plugin/sidebar/**",
    "hosts/bb/plugin/components/**",
    "hosts/bb/plugin/lib/**",
    "hosts/bb/plugin/hooks/**",
    "hosts/bb/plugin/app.tsx",
    "hosts/bb/plugin/test-setup.ts"
  ]
}
